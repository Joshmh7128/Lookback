root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,csproj,slnx,proto}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:suggestion
dotnet_style_readonly_field = true:warning
# Hot-path code uses explicit types; allow var elsewhere.
csharp_style_var_for_built_in_types = false:none
# CA1716/CA1711: names like "Stream" and "EventHandler" are intentional domain terms.
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1716.severity = none
# Library code awaits with ConfigureAwait(false).
dotnet_diagnostic.CA2007.severity = warning

[tests/**.cs]
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1861.severity = none

# Console executables have no synchronization context to escape.
[src/Lookback.Testbench/**.cs]
dotnet_diagnostic.CA2007.severity = none

# The capture bench tool is a console executable too.
[src/Lookback.Capture.Cli/**.cs]
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1869.severity = none

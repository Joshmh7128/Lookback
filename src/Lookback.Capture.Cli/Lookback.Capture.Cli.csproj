<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>lookback-capture</AssemblyName>
    <Description>Bench tool for live capture: captures a window or monitor, runs the signal pipeline, and reports rates; optionally encodes and saves a clip of the last seconds. Optional live profiler page.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lookback.Audio\Lookback.Audio.csproj" />
    <ProjectReference Include="..\Lookback.Capture\Lookback.Capture.csproj" />
    <ProjectReference Include="..\Lookback.Encode\Lookback.Encode.csproj" />
    <ProjectReference Include="..\Lookback.Governor.Windows\Lookback.Governor.Windows.csproj" />
    <ProjectReference Include="..\Lookback.Stream\Lookback.Stream.csproj" />
    <ProjectReference Include="..\Lookback.Profiler\Lookback.Profiler.csproj" />
    <ProjectReference Include="..\Lookback.Profiles\Lookback.Profiles.csproj" />
  </ItemGroup>
</Project>

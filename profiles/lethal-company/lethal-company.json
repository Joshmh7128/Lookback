{
  // Lethal Company: co-op horror scavenging on abandoned moons to meet a
  // quota. The clips people keep are jumpscares, deaths, near misses and the
  // ship leaving without someone. One HUD everywhere, so no sub-games.
  "id": "lethal-company",
  "displayName": "Lethal Company",
  "version": 1,
  "level": "game",
  "tags": ["horror", "co-op", "survival"],
  "executables": ["Lethal Company.exe"],
  "capturePolicy": {
    "allowPresentHook": false,
    "allowMemoryReading": false,
    "notes": "No anti-cheat, but Lookback stays vision and audio only: external capture, no mods, no injection, no memory reads."
  },
  "reference": {
    "aspect": "16:9",
    "calibrated": false,
    "notes": "Region positions are estimates of the default HUD. The game renders at a low internal resolution and is dark; calibrate with: analyze <footage> --profile lethal-company."
  },
  "regions": [
    { "name": "vitals",      "x": 0.01, "y": 0.03, "w": 0.12, "h": 0.25, "purpose": "Health silhouette and stamina, top left." },
    { "name": "clock",       "x": 0.40, "y": 0.00, "w": 0.20, "h": 0.07, "purpose": "Time of day while outside; warnings appear near it." },
    { "name": "inventory",   "x": 0.70, "y": 0.88, "w": 0.28, "h": 0.11, "purpose": "Four inventory slots, bottom right." },
    { "name": "centre_text", "x": 0.20, "y": 0.30, "w": 0.60, "h": 0.30, "purpose": "Centre messages: landing, ship leaving, quota, fired." },
    { "name": "view",        "x": 0.20, "y": 0.20, "w": 0.60, "h": 0.60, "purpose": "Middle of the picture." }
  ],
  "events": [
    {
      // Jumpscare: a sudden loud sound and a lurch of the picture.
      "name": "jumpscare",
      "weight": 1.5,
      "baseConfidence": 0.4,
      "cooldownMs": 4000,
      "when": [ { "signal": "audio.rms_db", "rise": 15, "baselineAlpha": 0.02 } ],
      "boosts": [
        { "signal": "motion.energy", "above": 0.1, "withinMs": 500, "add": 0.2 },
        { "signal": "spectral.onset", "above": 0.6, "withinMs": 200, "add": 0.1 }
      ],
      "clip": { "preMs": 8000, "postMs": 4000 }
    },
    {
      // Hurt: the health silhouette changes and the screen edge reddens.
      "name": "damage_taken",
      "weight": 0.5,
      "baseConfidence": 0.4,
      "cooldownMs": 2000,
      "when": [ { "signal": "region.vitals.activity", "rise": 0.05 } ],
      "boosts": [ { "signal": "flash.red_edge", "above": 0.05, "withinMs": 500, "add": 0.2 } ],
      "clip": { "preMs": 6000, "postMs": 3000 }
    },
    {
      // Death: a cut, then the dark spectator view.
      "name": "death",
      "weight": 1.0,
      "baseConfidence": 0.4,
      "cooldownMs": 15000,
      "when": [ { "signal": "scene.cut", "above": 0.5 } ],
      "boosts": [
        { "signal": "region.vitals.activity", "above": 0.03, "withinMs": 1500, "add": 0.2 },
        { "signal": "audio.peak_db", "above": -6, "withinMs": 1000, "add": 0.1 }
      ],
      "clip": { "preMs": 15000, "postMs": 3000 }
    },
    {
      // The ship is leaving, the quota is met, or the crew is fired: text in the centre.
      "name": "ship_message",
      "weight": 0.7,
      "baseConfidence": 0.4,
      "cooldownMs": 20000,
      "when": [ { "signal": "region.centre_text.activity", "rise": 0.08 } ],
      "boosts": [ { "signal": "spectral.onset", "above": 0.5, "withinMs": 800, "add": 0.1 } ],
      "clip": { "preMs": 15000, "postMs": 5000 }
    },
    {
      // Picked up or dropped scrap: the inventory changes. Context more than a clip.
      "name": "loot",
      "weight": 0.1,
      "baseConfidence": 0.5,
      "cooldownMs": 3000,
      "when": [ { "signal": "region.inventory.activity", "rise": 0.05 } ],
      "clip": { "preMs": 3000, "postMs": 2000 }
    }
  ],
  "composites": [
    { "name": "close_call", "of": "damage_taken", "atLeast": 2, "withinMs": 10000, "weight": 1.5, "clip": { "preMs": 12000, "postMs": 4000 } },
    { "name": "nightmare",  "of": "jumpscare",    "atLeast": 2, "withinMs": 30000, "weight": 2.0, "clip": { "preMs": 20000, "postMs": 5000 } }
  ]
}

{
  // R.E.P.O.: co-op horror where a team of robots hauls fragile valuables to an
  // extraction point while monsters hunt them. The clips people keep are
  // monster scares, valuables smashed into the walls and frantic extractions.
  // One HUD everywhere, so no sub-games or modes.
  "id": "repo",
  "displayName": "R.E.P.O.",
  "version": 1,
  "level": "game",
  "tags": ["horror", "co-op", "physics"],
  "executables": ["REPO.exe"],
  "capturePolicy": {
    "allowPresentHook": false,
    "allowMemoryReading": false,
    "notes": "No anti-cheat, but Lookback stays vision and audio only: external capture, no mods, no injection, no memory reads."
  },
  "reference": {
    "aspect": "16:9",
    "calibrated": false,
    "notes": "Region positions are estimates; the HUD is small and minimal. Calibrate with: analyze <footage> --profile repo."
  },
  "regions": [
    { "name": "vitals",      "x": 0.01, "y": 0.01, "w": 0.20, "h": 0.10, "purpose": "Health and energy, top left." },
    { "name": "haul",        "x": 0.78, "y": 0.01, "w": 0.21, "h": 0.10, "purpose": "Haul value against the level's goal, top right; it drops when a valuable is damaged." },
    { "name": "centre_text", "x": 0.25, "y": 0.30, "w": 0.50, "h": 0.25, "purpose": "Centre messages: level start, extraction, run over." },
    { "name": "view",        "x": 0.20, "y": 0.20, "w": 0.60, "h": 0.60, "purpose": "Middle of the picture." }
  ],
  "events": [
    {
      // A monster: a sudden loud sound and a sudden scramble of motion.
      "name": "monster_scare",
      "weight": 1.2,
      "baseConfidence": 0.4,
      "cooldownMs": 5000,
      "when": [ { "signal": "audio.rms_db", "rise": 15, "baselineAlpha": 0.02 } ],
      "boosts": [
        { "signal": "motion.energy", "above": 0.1, "withinMs": 800, "add": 0.2 },
        { "signal": "scene.cut", "above": 0.4, "withinMs": 500, "add": 0.1 }
      ],
      "clip": { "preMs": 8000, "postMs": 4000 }
    },
    {
      // A valuable is damaged: the haul number drops with a crash.
      "name": "valuable_damaged",
      "weight": 0.8,
      "baseConfidence": 0.4,
      "cooldownMs": 1500,
      "when": [ { "signal": "region.haul.activity", "rise": 0.05 } ],
      "boosts": [ { "signal": "audio.peak_db", "above": -8, "withinMs": 300, "add": 0.25 } ],
      "clip": { "preMs": 6000, "postMs": 3000 }
    },
    {
      // Hurt: the health readout changes, often with red at the edges.
      "name": "damage_taken",
      "weight": 0.4,
      "baseConfidence": 0.4,
      "cooldownMs": 2000,
      "when": [ { "signal": "region.vitals.activity", "rise": 0.05 } ],
      "boosts": [ { "signal": "flash.red_edge", "above": 0.05, "withinMs": 500, "add": 0.2 } ],
      "clip": { "preMs": 6000, "postMs": 3000 }
    },
    {
      // Death: the picture cuts away and goes dark.
      "name": "death",
      "weight": 0.9,
      "baseConfidence": 0.4,
      "cooldownMs": 15000,
      "when": [ { "signal": "luma.mean", "below": 0.08 } ],
      "boosts": [ { "signal": "scene.cut", "above": 0.4, "withinMs": 1500, "add": 0.2 } ],
      "clip": { "preMs": 15000, "postMs": 3000 }
    },
    {
      // Extraction or a level message in the centre.
      "name": "extraction",
      "weight": 1.0,
      "baseConfidence": 0.4,
      "cooldownMs": 30000,
      "when": [ { "signal": "region.centre_text.activity", "rise": 0.08 } ],
      "boosts": [ { "signal": "spectral.onset", "above": 0.5, "withinMs": 800, "add": 0.15 } ],
      "clip": { "preMs": 20000, "postMs": 5000 }
    }
  ],
  "composites": [
    { "name": "expensive_disaster", "of": "valuable_damaged", "atLeast": 3, "withinMs": 10000, "weight": 2.0, "clip": { "preMs": 10000, "postMs": 3000 } },
    { "name": "hunted",             "of": "monster_scare",    "atLeast": 2, "withinMs": 20000, "weight": 2.0, "clip": { "preMs": 20000, "postMs": 4000 } }
  ]
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows 10 2004+ (19041). Process loopback needs build 20348 and is checked at runtime. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Description>Live audio capture on Windows: WASAPI endpoint loopback of the default render device, process loopback where the OS has it, and the microphone, stamped in QPC through SampleClock and handed on as 48 kHz stereo PCM and analysis hops.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lookback.Contracts\Lookback.Contracts.csproj" />
    <ProjectReference Include="..\Lookback.Media\Lookback.Media.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lookback.Audio.Tests" />
  </ItemGroup>
</Project>

{
  // Works on any game: no regions, only the game-agnostic signals. The fallback
  // when a game has no profile yet, and a baseline to compare profiles against.
  "id": "generic",
  "displayName": "Any game",
  "version": 1,
  "capturePolicy": { "allowPresentHook": false, "allowMemoryReading": false, "notes": "Unknown game: assume anti-cheat." },
  "reference": { "calibrated": true, "notes": "No regions to calibrate." },
  "events": [
    {
      "name": "impact",
      "weight": 0.6,
      "baseConfidence": 0.4,
      "cooldownMs": 500,
      "when": [ { "signal": "flash.brighten", "above": 0.08 } ],
      "boosts": [ { "signal": "spectral.onset", "above": 0.5, "withinMs": 200, "add": 0.3 } ]
    },
    {
      "name": "hud_change",
      "weight": 0.5,
      "baseConfidence": 0.4,
      "cooldownMs": 500,
      "when": [ { "signal": "hud.activity", "rise": 0.03 } ],
      "boosts": [ { "signal": "spectral.onset", "above": 0.5, "withinMs": 250, "add": 0.2 } ]
    },
    {
      "name": "loud_moment",
      "weight": 0.4,
      "baseConfidence": 0.4,
      "cooldownMs": 1500,
      "when": [ { "signal": "audio.rms_db", "rise": 12, "baselineAlpha": 0.01 } ]
    }
  ],
  "composites": [
    { "name": "action_burst", "of": "impact", "atLeast": 3, "withinMs": 5000, "weight": 1.5 }
  ]
}

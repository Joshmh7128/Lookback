<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Description>Media Foundation encoding for live capture: hardware video encoder MFTs (NVENC, AMF, QSV) on the capture device, a software fallback, and AAC. Output goes to an IPacketSink such as the replay ring.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.MediaFoundation" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lookback.Capture\Lookback.Capture.csproj" />
    <ProjectReference Include="..\Lookback.Replay\Lookback.Replay.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lookback.Capture.Tests" />
  </ItemGroup>
</Project>

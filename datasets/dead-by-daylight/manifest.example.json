  // The times below are placeholders showing the shape, not real labels.
  //
  // profile: the deepest profile each file shows. One manifest covers the whole
  // dead-by-daylight tree, so fingerprints can be learned for every sub-game and mode:
  //   lookback-testbench fingerprint datasets/dead-by-daylight/manifest.json
  //   lookback-testbench dataset datasets/dead-by-daylight/manifest.json --profiles fingerprint-out/learned
  // Third-party footage needs retention permissioned or open-license and a permissionRef.
  "game": "dead-by-daylight",
  "entries": [
    {
      "file": "media/survivor-01.mp4",
      "source": "own recording, 1920x1080, default HUD",

{
  // PEAK: co-op climbing up a procedurally generated island. The stamina bar
  // carries the story: it fills with colour as climbers get hurt, hungry, cold
  // or poisoned. The clips people keep are falls, rescues and reaching
  // campfires and the summit. One HUD everywhere, so no sub-games.
  "id": "peak",
  "displayName": "PEAK",
  "version": 1,
  "level": "game",
  "tags": ["co-op", "climbing", "survival"],
  "executables": ["PEAK.exe"],
  "capturePolicy": {
    "allowPresentHook": false,
    "allowMemoryReading": false,
    "notes": "No anti-cheat, but Lookback stays vision and audio only: external capture, no mods, no injection, no memory reads."
  },
  "reference": {
    "aspect": "16:9",
    "calibrated": false,
    "notes": "Region positions are estimates of the default HUD. Calibrate with: analyze <footage> --profile peak."
  },
  "regions": [
    { "name": "stamina",     "x": 0.02, "y": 0.88, "w": 0.40, "h": 0.08, "purpose": "Stamina bar; injury shows as red, hunger yellow, cold blue, poison green." },
    { "name": "inventory",   "x": 0.42, "y": 0.88, "w": 0.20, "h": 0.10, "purpose": "Item slots, bottom centre." },
    { "name": "centre_text", "x": 0.25, "y": 0.18, "w": 0.50, "h": 0.20, "purpose": "Area names and milestone text (a new biome, the summit)." },
    { "name": "view",        "x": 0.20, "y": 0.20, "w": 0.60, "h": 0.60, "purpose": "Middle of the picture." }
  ],
  "events": [
    {
      // A fall: the whole picture tumbles and lands with a thud.
      "name": "fall",
      "weight": 1.2,
      "baseConfidence": 0.4,
      "cooldownMs": 4000,
      "when": [ { "signal": "motion.coverage", "above": 0.7 } ],
      "boosts": [
        { "signal": "audio.peak_db", "above": -8, "withinMs": 2000, "add": 0.2 },
        { "signal": "region.stamina.red", "above": 0.15, "withinMs": 2500, "add": 0.2 }
      ],
      "clip": { "preMs": 8000, "postMs": 4000 }
    },
    {
      // Injured: red spreads into the stamina bar.
      "name": "injury",
      "weight": 0.5,
      "baseConfidence": 0.45,
      "cooldownMs": 3000,
      "when": [ { "signal": "region.stamina.red", "rise": 0.05 } ],
      "clip": { "preMs": 8000, "postMs": 2000 }
    },
    {
      // Passed out: the picture fades to dark.
      "name": "passed_out",
      "weight": 1.0,
      "baseConfidence": 0.4,
      "cooldownMs": 15000,
      "when": [ { "signal": "luma.mean", "below": 0.06 } ],
      "clip": { "preMs": 15000, "postMs": 3000 }
    },
    {
      // A new area or the summit: text in the upper centre, often with music.
      "name": "milestone",
      "weight": 1.0,
      "baseConfidence": 0.4,
      "cooldownMs": 60000,
      "when": [
        { "signal": "region.centre_text.activity", "rise": 0.06 },
        { "signal": "region.centre_text.luma", "above": 0.3 }
      ],
      "clip": { "preMs": 15000, "postMs": 6000 }
    },
    {
      // Stamina runs out mid-climb: the bar empties quickly.
      "name": "stamina_crash",
      "weight": 0.3,
      "baseConfidence": 0.4,
      "cooldownMs": 5000,
      "when": [ { "signal": "region.stamina.activity", "rise": 0.06 } ],
      "clip": { "preMs": 6000, "postMs": 3000 }
    }
  ],
  "composites": [
    { "name": "rough_climb", "of": "injury", "atLeast": 3, "withinMs": 20000, "weight": 1.5, "clip": { "preMs": 20000, "postMs": 3000 } },
    { "name": "tumble",      "of": "fall",   "atLeast": 2, "withinMs": 10000, "weight": 2.0, "clip": { "preMs": 12000, "postMs": 4000 } }
  ]
}

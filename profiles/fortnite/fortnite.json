{
  // Fortnite: battle royale with anti-cheat (Easy Anti-Cheat) and no public
  // live game-state API. Vision and audio only. The game level covers Battle
  // Royale with building; modes adjust it (Zero Build has no building, Reload
  // has respawns). Creative and UEFN islands are a separate experience per
  // island code and are not covered yet.
  "id": "fortnite",
  "displayName": "Fortnite",
  "version": 1,
  "level": "game",
  "tags": ["shooter", "battle-royale", "building", "anti-cheat"],
  "executables": ["FortniteClient-Win64-Shipping.exe"],
  "capturePolicy": {
    "allowPresentHook": false,
    "allowMemoryReading": false,
    "notes": "Anti-cheat (Easy Anti-Cheat): external capture (Windows.Graphics.Capture) only. No injection, no memory reads."
  },
  "reference": {
    "aspect": "16:9",
    "calibrated": false,
    "notes": "Region positions are estimates of the default HUD at 16:9 and 100% HUD scale. Fortnite's HUD layout is customisable; calibrate with testbench analyze --profile fortnite."
  },
  "regions": [
    { "name": "minimap",       "x": 0.83, "y": 0.02, "w": 0.16, "h": 0.27, "purpose": "Minimap, top right. Mostly for learning mode fingerprints." },
    { "name": "match_info",    "x": 0.80, "y": 0.29, "w": 0.19, "h": 0.06, "purpose": "Storm timer, players left and your elimination count under the minimap." },
    { "name": "elim_feed",     "x": 0.00, "y": 0.52, "w": 0.30, "h": 0.20, "purpose": "Elimination and knock feed, left side." },
    { "name": "elim_notice",   "x": 0.35, "y": 0.62, "w": 0.30, "h": 0.08, "purpose": "Your own eliminations and knocks are announced below the crosshair." },
    { "name": "banner",        "x": 0.20, "y": 0.15, "w": 0.60, "h": 0.35, "purpose": "Large centre text: Victory Royale, placement, storm warnings." },
    { "name": "health_shield", "x": 0.02, "y": 0.88, "w": 0.25, "h": 0.10, "purpose": "Health and shield bars, bottom left." },
    { "name": "hotbar",        "x": 0.70, "y": 0.86, "w": 0.28, "h": 0.13, "purpose": "Weapon and building hotbar, bottom right. Changes on every swap between weapons and build pieces." }
  ],
  "events": [
    {
      // Your elimination or knock: the notice below the crosshair changes,
      // and your elimination count under the minimap ticks up.
      "name": "elimination",
      "weight": 1.0,
      "baseConfidence": 0.5,
      "cooldownMs": 300,
      "whenAny": [ { "signal": "region.elim_notice.activity", "rise": 0.05 } ],
      "boosts": [
        { "signal": "region.match_info.activity", "above": 0.02, "withinMs": 800, "add": 0.2 },
        { "signal": "spectral.onset", "above": 0.5, "withinMs": 250, "add": 0.15 },
        { "signal": "region.elim_feed.activity", "above": 0.02, "withinMs": 800, "add": 0.1 }
      ],
      "clip": { "preMs": 8000, "postMs": 3000 }
    },
    {
      "name": "elim_feed_activity",
      "weight": 0.25,
      "baseConfidence": 0.6,
      "cooldownMs": 400,
      "when": [ { "signal": "region.elim_feed.activity", "rise": 0.03 } ],
      "clip": { "preMs": 4000, "postMs": 2000 }
    },
    {
      // A burst of swaps between weapons and build pieces, with motion. The
      // build_fight composite turns a run of these into a clip.
      "name": "build_burst",
      "weight": 0.2,
      "baseConfidence": 0.5,
      "cooldownMs": 300,
      "when": [
        { "signal": "region.hotbar.activity", "rise": 0.04 },
        { "signal": "motion.energy", "above": 0.05 }
      ],
      "clip": { "preMs": 3000, "postMs": 2000 }
    },
    {
      // The gold Victory Royale banner: large, bright, saturated and new.
      "name": "victory_royale",
      "weight": 5.0,
      "baseConfidence": 0.5,
      "cooldownMs": 120000,
      "when": [
        { "signal": "region.banner.activity", "rise": 0.15 },
        { "signal": "region.banner.luma", "above": 0.5 },
        { "signal": "region.banner.saturation", "above": 0.35 }
      ],
      "boosts": [ { "signal": "audio.rms_db", "above": -25, "withinMs": 1000, "add": 0.2 } ],
      "clip": { "preMs": 30000, "postMs": 6000 }
    },
    {
      "name": "low_health",
      "weight": 0.2,
      "baseConfidence": 0.6,
      "cooldownMs": 3000,
      "when": [ { "signal": "flash.red_edge", "above": 0.06 } ],
      "clip": { "preMs": 3000, "postMs": 3000 }
    },
    {
      "name": "death",
      "weight": 0.2,
      "baseConfidence": 0.45,
      "cooldownMs": 10000,
      "when": [
        { "signal": "scene.cut", "above": 0.3 },
        { "signal": "region.health_shield.activity", "rise": 0.04 }
      ],
      "clip": { "preMs": 10000, "postMs": 1000 }
    }
  ],
  "composites": [
    { "name": "multikill",   "of": "elimination", "atLeast": 2, "withinMs": 6000,  "weight": 2.5, "clip": { "preMs": 8000, "postMs": 4000 } },
    { "name": "squad_wipe",  "of": "elimination", "atLeast": 4, "withinMs": 20000, "weight": 4.5, "clip": { "preMs": 12000, "postMs": 4000 } },
    { "name": "build_fight", "of": "build_burst", "atLeast": 6, "withinMs": 6000,  "weight": 1.8, "clip": { "preMs": 6000, "postMs": 4000 } },
    { "name": "hot_zone",    "of": "elim_feed_activity", "atLeast": 4, "withinMs": 15000, "weight": 1.0, "clip": { "preMs": 8000, "postMs": 4000 } }
  ]
}

  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lookback.Profiles\Lookback.Profiles.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lookback.Detection.Tests" />
  </ItemGroup>
</Project>

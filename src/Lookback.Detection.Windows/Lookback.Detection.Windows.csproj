<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Description>Game detection on Windows: the process list (Toolhelp), executable paths and launch arguments through query-only handles, and top-level windows, plus the capture target for a detected game. Never opens a game's memory, injects or hooks.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lookback.Detection\Lookback.Detection.csproj" />
    <ProjectReference Include="..\Lookback.Capture\Lookback.Capture.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lookback.Detection.Windows.Tests" />
  </ItemGroup>
</Project>
